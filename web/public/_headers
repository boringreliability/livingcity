# Cloudflare Pages response headers (copied into dist/ by Vite).
# Cross-origin isolation gives the worker a fine-grained performance.now() (the diagnostics'
# tick timings); every resource is same-origin, so require-corp blocks nothing.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Content-hashed build output never changes under the same name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
